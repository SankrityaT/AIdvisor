# ASU AIR OpenAI-compatible API
AIR_API_KEY=replace-with-your-air-api-key
AIR_BASE_URL=https://openai.rc.asu.edu/v1
AIR_TEXT_MODEL=glm-5-3-flash
AIR_REASONER_MODEL=qwen3-235b-a22b-thinking-2507

# Optional voice-model overrides
AIR_ASR_MODEL=qwen3-asr-1p7b
AIR_TTS_MODEL=qwen3-tts-customvoice-1p7b

# Exact frontend origin allowed to call the production API
FRONTEND_ORIGIN=https://your-frontend.example

